# Supabase (Project settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never NEXT_PUBLIC
# Claude Platform (AI-01) — server only
ANTHROPIC_API_KEY=
# Microsoft Graph (app registration S.A.M., IT Clair Group)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Supabase Management API (Settings › Core: apply migrations from the app) — personal access token, server only
SUPABASE_ACCESS_TOKEN=
# Teams bot S.A.M. (TMS-01): id of the S.A.M. app in the Teams catalog (proactive installation); the Azure Bot reuses GRAPH_CLIENT_ID / SECRET
TEAMS_APP_ID=   # optional: catalog id of the S.A.M. Teams app; defaults to the Clair Group one in lib/teams.ts
# TEAMS_SERVICE_URL=https://smba.trafficmanager.net/emea/
# SAM_ORIGIN=https://sam.clair-group.com
# Vercel cron protection
CRON_SECRET=
